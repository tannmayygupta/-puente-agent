{
  "name": "puente-agent",
  "version": "0.1.0",
  "description": "Puente: pay anyone in LatAm in their local currency from dollars, via x402 + Textile FX on Celo mainnet.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "wallet:new": "node scripts/gen-wallet.mjs",
    "status": "tsx scripts/status.ts",
    "t1": "tsx scripts/t1-textile-swap.ts",
    "t1-celo": "tsx scripts/t1-celo-swap.ts",
    "t2": "tsx scripts/t2-pay.ts",
    "live-prep": "tsx scripts/live-prep.ts",
    "t4": "tsx scripts/t4-buy.ts",
    "proof": "tsx scripts/export-buy-proof.ts",
    "register8004": "tsx scripts/register8004.ts",
    "build:web": "node scripts/build-web.mjs"
  },
  "dependencies": {
    "@celo/attribution-tags": "0.5.0",
    "@hono/node-server": "^2.1.6",
    "@x402/core": "2.30.0",
    "@x402/evm": "2.30.0",
    "@x402/fetch": "2.30.0",
    "@x402/hono": "2.30.0",
    "dotenv": "^18.0.9",
    "hono": "4.13.17",
    "tsx": "^4.23.15",
    "viem": "2.57.11"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.6.0"
  }
}


