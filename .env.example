# Copy to .env (git-ignored). NEVER commit real values.

# Puente agent wallet (wallet T). Generated by `npm run wallet:new`.
# One wallet for the whole event: it is PayTo, ERC-8004 owner, tx sender and buy payer.
AGENT_PRIVATE_KEY=
AGENT_ADDRESS=

# Hackathon attribution tag (ERC-8021) - appended to every tx we send
ATTRIBUTION_CODE=celo_eabed0a00299

# Celo mainnet
CELO_RPC_URL=https://forno.celo.org
X402_NETWORK=mainnet

# x402 seller key from https://x402.celo.org (human signs in; server-side secret)
X402_API_KEY=

# Textile FX (optional live key; keyless preview works on Celo mainnet)
TEXTILE_API_KEY=
